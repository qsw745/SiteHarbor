{
  "name": "siteharbor",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run typecheck && next build",
    "build:docker": "prisma generate && next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "hash-password": "node scripts/hash-password.mjs",
    "issue-admin-reset-token": "node scripts/issue-admin-reset-token.mjs",
    "reset-admin-password": "node scripts/reset-admin-password.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.555.0",
    "next": "16.2.6",
    "prisma": "6.19.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
